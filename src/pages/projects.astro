---
import Base from "../layouts/Base.astro";
import { projectGroups } from "../data/profile";
---
<Base title="Projects — Tarek Ghoul" description="Industry, government, and research projects by Tarek Ghoul.">
  <main id="main" class="wrap">
    <header class="page-title">
      <h1>Projects</h1>
      <p class="lede">
        This page covers industry and government work, then published research.
      </p>
    </header>
    {
      projectGroups.map((group) => (
        <section class="group" id={group.id} aria-labelledby={`${group.id}-title`}>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          {group.projects.map((project) => (
            <article class="project" id={project.id || undefined}>
              <h3>
                {project.href ? (
                  <a href={project.href}>{project.title}</a>
                ) : (
                  project.title
                )}
              </h3>
              <p class="where">{project.where}</p>
              {project.image && (
                <img
                  class:list={{ clip: Boolean(project.poster) }}
                  src={project.image}
                  data-still={project.poster}
                  alt={project.imageAlt}
                  width="1100"
                  height="473"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <p>{project.text}</p>
            </article>
          ))}
        </section>
      ))
    }
  </main>
</Base>
