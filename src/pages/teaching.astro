---
import Base from "../layouts/Base.astro";
import { teaching, teachingTopics } from "../data/profile";
---
<Base title="Teaching — Tarek Ghoul" description="Courses taught by Tarek Ghoul at the University of British Columbia.">
  <main id="main" class="wrap">
    <header class="page-title">
      <h1>Teaching</h1>
      <p class="lede">
        Since 2020 I have taught at UBC across graduate statistics, large undergraduate transportation courses, and capstone design.
        I have also trained graduate students in computer vision, simulation, and reinforcement learning.
      </p>
      <div class="actions">
        {teachingTopics.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <section class="group" aria-labelledby="courses">
      <h2 id="courses">Courses</h2>
      {
        teaching.map((c) => (
          <article class="row">
            <div class="year">{c.code}</div>
            <div>
              <h3>{c.title}</h3>
              <p class="meta">{c.level}. {c.years}.</p>
              <p>{c.role}</p>
            </div>
          </article>
        ))
      }
    </section>
  </main>
</Base>
