---
import Base from "../layouts/Base.astro";
import ConflictDemo from "../components/demos/ConflictDemo.astro";
import EvtDemo from "../components/demos/EvtDemo.astro";
import RouteDemo from "../components/demos/RouteDemo.astro";
import SignalDemo from "../components/demos/SignalDemo.astro";
import { demos } from "../data/profile";
---
<Base title="Demos — Tarek Ghoul" description="Interactive explainers for real-time crash risk, safest routes, and safety-aware signal control.">
  <main id="main" class="wrap">
    <header class="page-title">
      <h1>Demos</h1>
      <p class="lede">
        Four small simulations that run in your browser, each explaining one idea from my published work. They use
        illustrative data and are labelled as such. The research pages have the real results.
      </p>
      <nav class="actions" aria-label="Demos on this page">
        {demos.map((d) => <a class="chip" href={d.href.replace("/demos", "")}>{d.title}</a>)}
      </nav>
    </header>
    <ConflictDemo />
    <EvtDemo />
    <RouteDemo />
    <SignalDemo />
  </main>
</Base>
