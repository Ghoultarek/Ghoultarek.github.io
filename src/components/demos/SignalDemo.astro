<section class="demo" id="signal" aria-labelledby="signal-title">
  <div class="demo-head">
    <h2 id="signal-title">Run the intersection</h2>
    <p>
      You control the lights for two minutes of traffic. Each switch shows yellow, then all-red. Switch too late and
      queues and delay build up. Switch while cars are in the shaded <em>dilemma zone</em> and a driver can neither stop
      comfortably nor clear the junction, which counts as a conflict. Play a round yourself, then compare a fixed-time plan
      with a safety-aware controller that waits for the dilemma zone to clear.
    </p>
  </div>
  <div class="demo-body">
    <canvas class="demo-canvas signal-map" data-map tabindex="0" role="img" aria-label="Four-way intersection. Press space to switch the lights when you are in control."></canvas>
    <div class="demo-controls">
      <label>Controller
        <select data-mode>
          <option value="you">You</option>
          <option value="fixed">Fixed-time (30 s per phase)</option>
          <option value="safe">Safety-aware</option>
        </select>
      </label>
      <label>Speed
        <select data-speed>
          <option value="1">1×</option>
          <option value="3" selected>3×</option>
          <option value="6">6×</option>
        </select>
      </label>
      <div class="demo-buttons">
        <button class="btn" type="button" data-start>Start round</button>
        <button class="chip" type="button" data-switch disabled>Switch lights (space)</button>
      </div>
    </div>
    <dl class="readouts" aria-live="polite">
      <div><dt>Time left</dt><dd data-r="time">120 s</dd></div>
      <div><dt>Dilemma-zone conflicts</dt><dd data-r="conf">0</dd></div>
      <div><dt>Average delay</dt><dd data-r="delay">–</dd></div>
      <div><dt>Vehicles served</dt><dd data-r="served">0</dd></div>
    </dl>
    <table class="scores" data-scores hidden>
      <caption>Your rounds</caption>
      <thead><tr><th scope="col">Controller</th><th scope="col">Conflicts</th><th scope="col">Avg delay</th><th scope="col">Served</th></tr></thead>
      <tbody></tbody>
    </table>
    <p class="demo-note">
      A toy simulation with random arrivals, and the same random seed for every round so the comparison is fair. My published controllers use
      reinforcement learning with extreme-value crash risk from camera trajectories. This game shows the same trade-off
      between safety and delay that those controllers optimise.
    </p>
  </div>
</section>

<script>
  import { rng } from "../../lib/demo-math.js";

  const root = document.getElementById("signal")!;
  const map = root.querySelector<HTMLCanvasElement>("[data-map]")!;
  const modeSel = root.querySelector<HTMLSelectElement>("[data-mode]")!;
  const speedSel = root.querySelector<HTMLSelectElement>("[data-speed]")!;
  const startBtn = root.querySelector<HTMLButtonElement>("[data-start]")!;
  const switchBtn = root.querySelector<HTMLButtonElement>("[data-switch]")!;
  const read = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;

  const VMAX = 13, LEN = 4.5, HALF = 10, YELLOW = 3, ALLRED = 1.5, MIN_GREEN = 5, MAX_GREEN = 40, ROUND = 120;
  const REACT = 1, COMFORT = 3;
  // Dilemma zone: too close to stop comfortably, too far to clear the junction before red.
  const DZ_NEAR = VMAX * YELLOW - 2 * HALF - LEN;
  const DZ_FAR = VMAX * REACT + (VMAX * VMAX) / (2 * COMFORT);
  const APPROACHES = [
    { name: "S", axis: "NS", rate: 0.2 }, { name: "N", axis: "NS", rate: 0.2 },
    { name: "W", axis: "EW", rate: 0.14 }, { name: "E", axis: "EW", rate: 0.14 },
  ] as const;

  type Car = { pos: number; v: number; committed: boolean; flagged: number };
  type Sim = { t: number; green: "NS" | "EW"; stage: "green" | "yellow" | "red"; stageT: number; next: "NS" | "EW";
    lanes: Car[][]; conflicts: number; delay: number; served: number; running: boolean; r: () => number; nextArrival: number[] };
  let sim: Sim;

  const css = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();

  function fresh(): Sim {
    const r = rng(42);
    const s: Sim = { t: 0, green: "NS", stage: "green", stageT: 0, next: "EW", lanes: APPROACHES.map(() => []),
      conflicts: 0, delay: 0, served: 0, running: false, r, nextArrival: [] };
    s.nextArrival = APPROACHES.map((a) => -Math.log(1 - r()) / a.rate);
    return s;
  }

  // Warm up 20 s so traffic is already flowing, then zero the clock and the score.
  function warm(s: Sim) {
    sim = s;
    const mode = modeSel.value;
    modeSel.value = "safe";
    for (let i = 0; i < 400; i++) step(0.05);
    modeSel.value = mode;
    s.nextArrival = s.nextArrival.map((x) => x - s.t);
    s.t = 0; s.conflicts = 0; s.delay = 0; s.served = 0;
    s.lanes.forEach((l) => l.forEach((c) => (c.flagged = 0)));
    return s;
  }

  const isGreen = (axis: string) => sim.stage === "green" && sim.green === axis;

  function requestSwitch() {
    if (!sim.running || sim.stage !== "green" || sim.stageT < MIN_GREEN) return;
    sim.stage = "yellow"; sim.stageT = 0; sim.next = sim.green === "NS" ? "EW" : "NS";
    APPROACHES.forEach((a, i) => {
      if (a.axis !== sim.green) return;
      for (const c of sim.lanes[i]) {
        if (c.pos <= 0 || c.committed) continue;
        const canStop = c.pos >= c.v * REACT + (c.v * c.v) / (2 * COMFORT);
        const canClear = c.pos + 2 * HALF + LEN <= c.v * YELLOW;
        if (!canStop) c.committed = true; // too close to stop: it proceeds
        if (!canStop && !canClear) { sim.conflicts++; c.flagged = 2; }
      }
    });
  }

  function controller() {
    const mode = modeSel.value;
    if (sim.stage !== "green") return;
    if (mode === "fixed" && sim.stageT >= 30) requestSwitch();
    if (mode === "safe" && sim.stageT >= MIN_GREEN) {
      const other = sim.green === "NS" ? "EW" : "NS";
      const waiting = APPROACHES.some((a, i) => a.axis === other && sim.lanes[i].some((c) => c.pos > 0 && c.pos < 60));
      const inZone = APPROACHES.some((a, i) => a.axis === sim.green && sim.lanes[i].some((c) => c.pos > DZ_NEAR - 2 && c.pos < DZ_FAR + 2 && c.v > 5));
      const gapOut = APPROACHES.every((a, i) => a.axis !== sim.green || !sim.lanes[i].some((c) => c.pos > 0 && c.pos < 25));
      if (waiting && ((!inZone && gapOut) || sim.stageT >= MAX_GREEN)) requestSwitch();
    }
  }

  function step(dt: number) {
    sim.t += dt; sim.stageT += dt;
    if (sim.stage === "yellow" && sim.stageT >= YELLOW) { sim.stage = "red"; sim.stageT = 0; }
    if (sim.stage === "red" && sim.stageT >= ALLRED) { sim.stage = "green"; sim.stageT = 0; sim.green = sim.next; }
    controller();
    APPROACHES.forEach((a, i) => {
      if (sim.t >= sim.nextArrival[i]) {
        const lane = sim.lanes[i];
        const last = lane[lane.length - 1];
        if (!last || last.pos < 140) lane.push({ pos: 150, v: VMAX * 0.9, committed: false, flagged: 0 });
        sim.nextArrival[i] = sim.t - Math.log(1 - sim.r()) / a.rate;
      }
      const lane = sim.lanes[i];
      lane.forEach((c, j) => {
        let gap = Infinity;
        if (j > 0) gap = c.pos - lane[j - 1].pos - LEN - 2;
        if (!isGreen(a.axis) && !c.committed && c.pos > 0) gap = Math.min(gap, c.pos - 0.5);
        const target = Math.min(VMAX, Math.sqrt(2 * 4.5 * Math.max(0, gap - 0.5)));
        c.v = target < c.v ? target : Math.min(target, c.v + 2.5 * dt);
        const before = c.pos;
        c.pos -= c.v * dt;
        if (before > 0 && c.pos <= 0) c.committed = true;
        if (c.flagged > 0) c.flagged -= dt;
        sim.delay += (1 - c.v / VMAX) * dt;
      });
      while (lane.length && lane[0].pos < -2 * HALF - 60) { lane.shift(); sim.served++; }
    });
  }

  function fitCanvas(c: HTMLCanvasElement) {
    const dpr = window.devicePixelRatio || 1;
    const w = c.clientWidth, h = c.clientHeight;
    if (c.width !== Math.round(w * dpr) || c.height !== Math.round(h * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); }
    const ctx = c.getContext("2d")!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { ctx, w, h };
  }

  function draw() {
    const { ctx, w, h } = fitCanvas(map);
    const ppm = Math.min(w, h) / 105, cx = w / 2, cy = h / 2;
    const ink = css("--ink"), muted = css("--muted"), card = css("--card"), risk = css("--risk"), safe = css("--safe"), warn = css("--warn"), bg = css("--bg");
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = card;
    ctx.fillRect(0, cy - 3.5 * ppm, w, 7 * ppm);
    ctx.fillRect(cx - 3.5 * ppm, 0, 7 * ppm, h);
    ctx.strokeStyle = muted; ctx.lineWidth = 1; ctx.setLineDash([6, 8]);
    ctx.beginPath();
    ctx.moveTo(0, cy); ctx.lineTo(cx - HALF * ppm, cy); ctx.moveTo(cx + HALF * ppm, cy); ctx.lineTo(w, cy);
    ctx.moveTo(cx, 0); ctx.lineTo(cx, cy - HALF * ppm); ctx.moveTo(cx, cy + HALF * ppm); ctx.lineTo(cx, h);
    ctx.stroke(); ctx.setLineDash([]);
    ctx.strokeStyle = ink; ctx.lineWidth = 2; ctx.beginPath();
    ctx.moveTo(cx, cy + HALF * ppm); ctx.lineTo(cx + 3.5 * ppm, cy + HALF * ppm);
    ctx.moveTo(cx - 3.5 * ppm, cy - HALF * ppm); ctx.lineTo(cx, cy - HALF * ppm);
    ctx.moveTo(cx - HALF * ppm, cy); ctx.lineTo(cx - HALF * ppm, cy + 3.5 * ppm);
    ctx.moveTo(cx + HALF * ppm, cy - 3.5 * ppm); ctx.lineTo(cx + HALF * ppm, cy);
    ctx.stroke();
    // Map an approach + distance-to-stop-line to canvas coordinates. Right-hand traffic.
    const at = (name: string, pos: number, lat = 1.75) => {
      const d = (HALF + pos) * ppm;
      if (name === "S") return [cx + lat * ppm, cy + d];
      if (name === "N") return [cx - lat * ppm, cy - d];
      if (name === "W") return [cx - d, cy + lat * ppm];
      return [cx + d, cy - lat * ppm];
    };
    // Dilemma-zone bands.
    ctx.fillStyle = risk; ctx.globalAlpha = 0.12;
    APPROACHES.forEach((a) => {
      const [x1, y1] = at(a.name, DZ_NEAR), [x2, y2] = at(a.name, DZ_FAR);
      const vertical = a.name === "S" || a.name === "N";
      if (vertical) ctx.fillRect(x1 - 1.75 * ppm, Math.min(y1, y2), 3.5 * ppm, Math.abs(y2 - y1));
      else ctx.fillRect(Math.min(x1, x2), y1 - 1.75 * ppm, Math.abs(x2 - x1), 3.5 * ppm);
    });
    ctx.globalAlpha = 1;
    // Signal heads at each stop line.
    APPROACHES.forEach((a) => {
      const [x, y] = at(a.name, -1, 4.5);
      const col = isGreen(a.axis) ? safe : sim.stage === "yellow" && sim.green === a.axis ? warn : risk;
      ctx.fillStyle = col; ctx.beginPath(); ctx.arc(x, y, Math.max(4, ppm * 1.4), 0, Math.PI * 2); ctx.fill();
    });
    // Vehicles.
    APPROACHES.forEach((a, i) => {
      const vertical = a.name === "S" || a.name === "N";
      for (const c of sim.lanes[i]) {
        const [x, y] = at(a.name, c.pos + LEN / 2);
        ctx.fillStyle = c.flagged > 0 ? risk : ink;
        const lw = (vertical ? 1.8 : LEN) * ppm, lh = (vertical ? LEN : 1.8) * ppm;
        ctx.fillRect(x - lw / 2, y - lh / 2, lw, lh);
      }
    });
    ctx.fillStyle = bg; ctx.globalAlpha = 0.85; ctx.fillRect(6, 6, 150, 22); ctx.globalAlpha = 1;
    ctx.fillStyle = muted; ctx.font = "12px Helvetica, Arial, sans-serif";
    const phase = sim.stage === "green" ? `${sim.green} green ${sim.stageT.toFixed(0)} s` : sim.stage === "yellow" ? `${sim.green} yellow` : "all red";
    ctx.fillText(phase, 12, 21);

    read("time").textContent = `${Math.max(0, ROUND - sim.t).toFixed(0)} s`;
    read("conf").textContent = String(sim.conflicts);
    read("served").textContent = String(sim.served);
    const seen = sim.served + sim.lanes.reduce((a, l) => a + l.length, 0);
    read("delay").textContent = seen && sim.t > 0 ? `${(sim.delay / seen).toFixed(1)} s/veh` : "–";
    switchBtn.disabled = !(sim.running && modeSel.value === "you" && sim.stage === "green" && sim.stageT >= MIN_GREEN);
  }

  function finish() {
    sim.running = false;
    startBtn.textContent = "Start round";
    const seen = sim.served + sim.lanes.reduce((a, l) => a + l.length, 0);
    const table = root.querySelector<HTMLTableElement>("[data-scores]")!;
    table.hidden = false;
    const row = table.tBodies[0].insertRow();
    [modeSel.options[modeSel.selectedIndex].text.replace(/ \(.*/, ""), String(sim.conflicts), `${(sim.delay / Math.max(1, seen)).toFixed(1)} s`, String(sim.served)]
      .forEach((v) => (row.insertCell().textContent = v));
    draw();
  }

  let last = 0;
  function loop(now: number) {
    if (!sim.running) return;
    const dt = Math.min(0.05, (now - last) / 1000 || 0) * +speedSel.value;
    last = now;
    const n = Math.ceil(dt / 0.02);
    for (let i = 0; i < n && sim.t < ROUND; i++) step(dt / n);
    if (sim.t >= ROUND) return finish();
    draw();
    requestAnimationFrame(loop);
  }

  startBtn.addEventListener("click", () => {
    if (sim.running) { sim.running = false; startBtn.textContent = "Resume"; return; }
    if (startBtn.textContent !== "Resume") warm(fresh());
    sim.running = true; startBtn.textContent = "Pause"; last = performance.now();
    if (modeSel.value === "you") map.focus();
    requestAnimationFrame(loop);
  });
  switchBtn.addEventListener("click", () => { requestSwitch(); draw(); });
  map.addEventListener("keydown", (e) => {
    if (e.key !== " ") return;
    e.preventDefault();
    if (modeSel.value === "you") { requestSwitch(); draw(); }
  });
  modeSel.addEventListener("change", () => { warm(fresh()); startBtn.textContent = "Start round"; draw(); });
  new ResizeObserver(draw).observe(map);
  new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  warm(fresh());
  draw();
</script>
